# Deny-all allowlist. This repo is published publicly, and the project folder
# holds client freight data, reports and results that must never be pushed.
# Everything is ignored by default; only the files the app needs are re-added.
/*

!.gitignore
!README.md
!Dockerfile
!requirements.txt
!app.py
!config.py
!cache.db
!core/
!agents/
!ui/
!tests/
!.streamlit/

# ...but never the compiled artefacts inside those packages
__pycache__/
*.pyc

# Runtime scratch dirs created by config.py
data/
output/
